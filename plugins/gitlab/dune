(library
 (public_name current_gitlab)
 (libraries
  atdgen-runtime
  cmdliner
  cohttp
  current
  current.cache
  current.http
  current_term
  current_git
  current_web
  eio
  fmt
  logs
  ptime
  prometheus
  result
  rresult
  uri
  yojson)
 (preprocess
  (pps ppx_deriving_yojson)))

(rule
 (targets gitlab_types_t.ml gitlab_types_t.mli)
 (deps gitlab_types.atd)
 (action (run atdgen -t %{deps})))

(rule
 (targets gitlab_types_j.ml gitlab_types_j.mli)
 (deps gitlab_types.atd)
 (action (run atdgen -j -j-std %{deps})))
